# 复制本文件为 .env 后填写实际值

# ===== 方式1：OpenAI =====
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ===== 方式2：DeepSeek（三行同时替换）=====
# OPENAI_API_KEY=你的DeepSeek密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# ===== 方式3：本地 Ollama（先 ollama run qwen2.5 拉取模型）=====
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5

# ===== 知识库向量化服务（必配，否则知识库不可用）=====
# 推荐使用通义/阿里云 DashScope，与下方通义千问共用密钥
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== 通义千问聊天模型（可在侧边栏切换，复用上方 EMBEDDING_* 密钥与地址）=====
QWEN_MODEL=qwen3.8-max

# ===== Rerank 重排模型（可选，使用智谱独立密钥；留空 RERANK_MODEL 或 RERANK_API_KEY 则关闭重排）=====
RERANK_API_KEY=你的智谱密钥
RERANK_MODEL=rerank
# RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/rerank
# 送入 Rerank 的候选数量
RERANK_CANDIDATES=20

# ===== 知识库参数（可选调整）=====
# 分块为结构感知模式：按标题→段落→句末标点智能切块，块上限与相邻块上下文回看
# KB_CHUNK_SIZE=700
# KB_CHUNK_OVERLAP=100
# KB_TOP_K=4
# KB_MIN_SCORE=0.25

# ===== Agent 自我审查（可选调整）=====
# REVIEW_ENABLED=true          # 是否启用自我审查（默认 true）
# REVIEWER_MODEL=              # 审查模型，留空则复用当前对话模型
# REVIEW_TEMPERATURE=0.3       # 审查温度，低温度确保审查稳定
# MAX_HISTORY_ROUNDS=10        # 历史对话保留轮数（上下文截断）
# MAX_HISTORY_CHARS=8000       # 历史对话保留字符数（上下文截断）
