# 复制本文件为 .env 后填写实际值

# ===== 方式1：OpenAI =====
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ===== 方式2：DeepSeek（三行同时替换）=====
# OPENAI_API_KEY=你的DeepSeek密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# ===== 方式3：本地 Ollama（先 ollama run qwen2.5 拉取模型）=====
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5

# ===== 知识库向量化服务（必配，否则知识库不可用）=====
# 推荐使用通义/阿里云 DashScope，与下方通义千问共用密钥
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== 通义千问聊天模型（可在侧边栏切换，复用上方 EMBEDDING_* 密钥与地址）=====
QWEN_MODEL=qwen3.8-max

# ===== Rerank 重排模型（可选，使用智谱独立密钥；留空 RERANK_MODEL 或 RERANK_API_KEY 则关闭重排）=====
RERANK_API_KEY=你的智谱密钥
RERANK_MODEL=rerank
# RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/rerank
# 送入 Rerank 的候选数量
RERANK_CANDIDATES=20

# ===== 知识库参数（可选调整）=====
# 分块为结构感知模式：按标题→段落→句末标点智能切块，块上限与相邻块上下文回看
# KB_CHUNK_SIZE=700
# KB_CHUNK_OVERLAP=100
# KB_TOP_K=4
# KB_MIN_SCORE=0.25

# ===== Agent 自我审查（可选调整）=====
# REVIEW_ENABLED=true          # 是否启用自我审查（默认 true）
# REVIEWER_MODEL=              # 审查模型，留空则复用当前对话模型
# REVIEW_TEMPERATURE=0.3       # 审查温度，低温度确保审查稳定
# MAX_HISTORY_ROUNDS=10        # 历史对话保留轮数（上下文截断）
# MAX_HISTORY_CHARS=8000       # 历史对话保留字符数（上下文截断）

# ===== 项目状态持久化数据库（Supabase PostgreSQL，可选）=====
# 说明：不配置则数据库能力自动降级，不影响现有对话/RAG/PPT/DOCX 流程。

# 方式A：直接用 Supabase 后台连接串（推荐）
# Supabase Dashboard → Project Settings → Database → Connection string 复制
# DATABASE_URL=postgresql://postgres.你的项目ID:你的数据库密码@aws-0-你的区域.pooler.supabase.com:6543/postgres
# 若连接提示需要 SSL，可在末尾追加 ?sslmode=require
# DATABASE_URL=postgresql://postgres.你的项目ID:你的数据库密码@aws-0-你的区域.pooler.supabase.com:6543/postgres?sslmode=require

# 方式B：分项配置（与 DATABASE_URL 二选一，DATABASE_URL 优先）
# DB_HOST=aws-0-你的区域.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.你的项目ID
# DB_PASSWORD=你的数据库密码

# 项目快照各列表条数上限（可选）
# PM_SNAPSHOT_LIMIT=5
